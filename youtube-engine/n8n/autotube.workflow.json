{
  "name": "AutoTube - Generate and Upload",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1,3,6"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Mon Wed Sat - 10 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:8000/run",
        "options": {}
      },
      "id": "start-worker",
      "name": "Start AutoTube Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Mon Wed Sat - 10 AM": {
      "main": [[{"node": "Start AutoTube Worker", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "timezone": "Asia/Kolkata",
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "autotube-v1"
}
