# Free-tier AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Channel / pipeline
CHANNEL_NICHE=Animated science, future technology and what-if simulations
VIDEO_LANGUAGE=en
VIDEOS_PER_WEEK=3
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=28

# Local paths inside worker container
DATA_DIR=/app/data
YOUTUBE_CLIENT_SECRETS=/app/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/app/secrets/youtube_token.json

# Optional curated RSS feeds (comma-separated)
RSS_FEEDS=https://www.nasa.gov/feed/,https://feeds.arstechnica.com/arstechnica/index

# n8n
GENERIC_TIMEZONE=Asia/Kolkata
N8N_PORT=5678
