# Free-tier AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Channel / pipeline
CHANNEL_NICHE=Animated science, future technology and what-if simulations
VIDEO_LANGUAGE=en
VIDEOS_PER_WEEK=3
UPLOAD_ENABLED=false
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=28

# Native deployment paths (relative paths resolve from youtube-engine/)
DATA_DIR=data
PIPER_MODEL=voices/en_US-ljspeech-medium.onnx
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# Optional curated RSS feeds (comma-separated)
RSS_FEEDS=https://www.nasa.gov/feed/,https://feeds.arstechnica.com/arstechnica/index

# Optional n8n deployment later
GENERIC_TIMEZONE=Asia/Kolkata
N8N_PORT=5678
